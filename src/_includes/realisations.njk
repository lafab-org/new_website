---
layout: base.njk
---
{{ content | safe }}
<div class="galerie">
{% for r in collections.realisations %}
<section class="realisation">
  <div class="photos" style="--n: {{ r.data.photos | length }}">
    {% for photo in r.data.photos %}
    <img style="--i: {{ loop.index0 }}" sizes="(min-width: 40rem) 12.7rem, calc((100vw - 2.75rem) / 2)" src="{{ r.page.filePathStem | replace('/index', '') }}/{{ photo.fichier }}" alt="{{ photo.description }}">
    {% endfor %}
  </div>
  {% if r.data.photos | length > 1 %}
  <p class="nombre-photos">{{ r.data.photos | length }} photos</p>
  {% endif %}
  <h2>{{ r.data.titre }}</h2>
  <p class="credit">Par {{ r.data.auteur }} · <span class="date">{{ r.data.date | moisAnnee }}</span></p>
</section>
{% endfor %}
</div>
