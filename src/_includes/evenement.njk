---
layout: base.njk
---
{%- set parts = page.filePathStem.split("/") -%}
{%- if parts.length == 3 and parts[1] == "evenements" and parts[2] != "index" %}
{% if accroche %}<p class="accroche"><strong>{{ accroche }}</strong></p>{% endif %}
<ul class="informations">
  <li><strong>Rendez-vous :</strong> {{ "rendez-vous" | champ }}</li>
  <li><strong>Horaire :</strong> {{ "horaire" | champ }}</li>
  <li><strong>Lieu :</strong> {{ site.lieu }}</li>
  <li><strong>Activité :</strong> {{ "prix" | champ }}</li>
</ul>
{%- set seancesPage = seances | seancesDe(parts[2]) %}
{%- include "prochaines-seances.njk" %}
{%- endif %}
<div class="corps">
{{ content | safe }}
</div>
