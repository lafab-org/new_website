<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url == "/" %}La Fabrique{% else %}{{ title }} - La Fabrique{% endif %}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {%- set ici = page.url | replace(r/(.)\/$/, "$1") %}
  {%- macro entree(nom, adresse, ici) -%}
  <li><a href="{{ adresse }}"{% if adresse == ici %} aria-current="page"{% endif %}>{{ nom }}</a></li>
  {%- endmacro %}
  <header>
    <div class="en-tete-haut">
      <a class="logo" href="/"><img src="/logo.svg" alt="La Fabrique - accueil" width="344" height="189" eleventy:ignore></a>
      <nav aria-label="Menu principal">
        <ul class="menu menu-principal">
          {{ entree("Agenda", "/agenda", ici) }}
          {{ entree("Actualités", "/actualites", ici) }}
          {{ entree("Réalisations", "/realisations", ici) }}
        </ul>
      </nav>
    </div>
    <nav aria-label="Ateliers et association">
      <ul class="menu menu-secondaire">
        {%- for a in ateliers %}
          {{ entree(a.menu, a.adresse, ici) }}
        {%- endfor %}
          {{ entree("L'association", "/association", ici) }}
      </ul>
    </nav>
  </header>
  <main>
    <h1>{{ title }}</h1>
    {{ content | safe }}
  </main>
</body>
</html>
